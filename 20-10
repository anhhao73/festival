                <path d="M50,62 Q40,90 50,100 Q60,90 50,62 Z" fill="#fff"/>
                <path d="M38,50 Q10,40 0,50 Q10,60 38,50 Z" fill="#fff"/>
                <path d="M62,50 Q90,40 100,50 Q90,60 62,50 Z" fill="#fff"/>
                <path d="M42,42 Q20,20 15,15 Q30,25 42,42 Z" fill="#fff"/>
                <path d="M58,58 Q80,80 85,85 Q70,75 58,58 Z" fill="#fff"/>
                <path d="M42,58 Q20,80 15,85 Q30,75 42,58 Z" fill="#fff"/>
                <path d="M58,42 Q80,20 85,15 Q70,25 58,42 Z" fill="#fff"/>
                <path d="M49,62 Q50,120 50,180" stroke="#74c69d" stroke-width="3" fill="none"/>
            </g>
        </defs>
    </svg>

    <div class="corner-text">Dành tặng, một người thương...</div>
    <div class="sound-btn" id="btn-sound" onclick="toggleSound()">🔔</div>
    <div id="particles"></div>

    <div id="scene-1">
        <div class="text-group">
            <h1 class="main-title">Từ một bông hoa nhỏ...</h1>
            <p class="sub-title">Chạm vào bông hoa nếu bạn đang thấy tò mò</p>
        </div>
        <svg viewBox="0 0 100 200" class="hero-flower" onclick="enterGarden()">
            <use href="#svg-rose"/>
        </svg>
    </div>

    <div id="scene-2">
        <div class="garden-instruction" id="garden-text">
            <h1 class="main-title">Tới những bông hoa, nở rộ thành vườn hoa...</h1>
            <p class="sub-title">Chạm vào một bông hoa bất kỳ để xem thông điệp</p>
        </div>
        <div class="garden-layer" id="garden-container"></div>
    </div>

    <div id="backdrop"></div>
    <div id="message-card">
        <svg viewBox="0 0 100 100" class="card-icon"><use href="#svg-rose" transform="scale(0.8) translate(10, 10)"/></svg>
        <div class="card-greet">Gửi bạn thương mến,</div>
        <div class="card-title" id="m-title"></div> 
        <div class="card-body" id="m-body"></div> 
        <div class="card-footer" id="m-footer">Gửi bạn thật nhiều thương mến ♡</div>
        <div class="card-sign" id="m-sign">người giấu tên</div>
    </div>

    <div id="btn-group">
        <button class="action-btn btn-accept" onclick="acceptGift()">Cho tui xin</button>
        <button class="action-btn btn-deny" id="btn-runaway">Gửi mình stk nhé</button>
    </div>

    <script>
        // =========================================================
        // ÂM THANH HỘP NHẠC (MUSIC BOX) ÊM DỊU, KHÔNG CHÓI TAI
        // =========================================================
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        let audioCtx;
        let isSoundOn = false;
        let ambientInterval;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new AudioContext();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        // Đã giảm âm lượng tối đa (volume = 0.012) và đổi sang sóng 'triangle' êm tai như đàn hạc
        function playChime(freq, type = 'triangle', volume = 0.05) {
            if (!audioCtx || !isSoundOn) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            
            osc.type = type;
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
            
            gain.gain.setValueAtTime(0, audioCtx.currentTime);
            gain.gain.linearRampToValueAtTime(volume, audioCtx.currentTime + 0.08);
            gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 2.5);
            
            osc.start(audioCtx.currentTime);
            osc.stop(audioCtx.currentTime + 2.5);
        }

        // Thang âm trầm ấm, thư giãn (Lofi/Music box scale)
        const musicBoxNotes = [220, 246.94, 277.18, 329.63, 369.99, 440, 493.88, 554.37];

        function playRandomChime() {
            const randomFreq = musicBoxNotes[Math.floor(Math.random() * musicBoxNotes.length)];
            playChime(randomFreq, 'triangle', 0.012);
        }

        function playTypingSound() {
            if (!audioCtx || !isSoundOn) return;
            playChime(600 + Math.random() * 200, 'sine', 0.003);
        }

        function toggleSound() {
            const btn = document.getElementById('btn-sound');
            isSoundOn = !isSoundOn;
            if(isSoundOn) {
                initAudio();
                btn.classList.add('playing');
                playRandomChime();
            } else {
                btn.classList.remove('playing');
            }
        }

        function startAmbientSound() {
            ambientInterval = setInterval(() => {
                if(isSoundOn && Math.random() > 0.4) {
                    playRandomChime();
                }
            }, 2500);
        }

        // KHO LỜI CHÚC
        const greetingsList = [
            {
                title: "Mong những<br>điều đẹp đẽ<br>luôn nở bên bạn.",
                body: "Một bông hoa có thể làm một ngày thêm đẹp. Còn bạn, làm thế giới này rạng rỡ hơn.\n\nNhân ngày 20/10, chúc bạn luôn được yêu thương, trân trọng và có thật nhiều niềm vui. Mong bạn dù ở bình yên độ tận hưởng những điều nhỏ bé, dù tự tin để theo đuổi những điều mình yêu."
            },
            {
                title: "Bạn vốn dĩ<br>đã là một<br>điều tuyệt vời.",
                body: "Không phải tự nhiên mà người ta gọi phụ nữ là phái đẹp. Vì sự hiện diện của bạn vốn dĩ đã là một món quà tuyệt vời của tạo hóa.\n\nChúc bạn 20/10 thật bình an, luôn giữ được nụ cười rạng rỡ trên môi. Cứ là chính mình, vì bạn là duy nhất và luôn tỏa sáng theo cách riêng!"
            },
            {
                title: "Hãy rạng rỡ<br>theo cách của<br>riêng mình.",
                body: "Hoa cần nắng để nở, còn thế giới này cần những người phụ nữ như bạn để trở nên ấm áp và trọn vẹn hơn.\n\nNgày 20/10, mong bạn hãy gác lại những âu lo thường nhật, dành trọn vẹn hôm nay để yêu thương bản thân. Chúc bạn luôn rạng rỡ, kiêu hãnh và ngập tràn hạnh phúc."
            },
            {
                title: "Một đời<br>an yên,<br>một đời rực rỡ.",
                body: "Tuổi trẻ có thể phai dấu theo thời gian, nhưng sự tự tin và nét duyên dáng của bạn thì luôn còn mãi.\n\nNhân ngày Phụ nữ Việt Nam, chúc bạn một đời an yên, làm những việc mình thích, đồng hành cùng người mình thương và sống một cuộc đời rực rỡ như những đóa hoa đang nở rộ ngoài kia."
            },
            {
                title: "Mỗi người là<br>một đóa hoa<br>độc nhất.",
                body: "Mỗi người phụ nữ mang một vẻ đẹp khác nhau: có người sắc sảo như hoa hồng, có người dịu dàng như hoa cúc trắng.\n\nNhưng dù là loài hoa nào, bạn cũng xứng đáng được nâng niu và trân trọng. Chúc bạn một ngày 20/10 nhận được thật nhiều tình yêu thương và những điều ngọt ngào nhất!"
            }
        ];

        const pContainer = document.getElementById('particles');
        for(let i=0; i<40; i++) {
            let p = document.createElement('div');
            p.classList.add('particle');
            let size = Math.random() * 6 + 3;
            p.style.width = size + 'px';
            p.style.height = size + 'px';
            p.style.left = Math.random() * 100 + 'vw';
            p.style.animationDuration = Math.random() * 8 + 6 + 's';
            p.style.animationDelay = Math.random() * 5 + 's';
            pContainer.appendChild(p);
        }

        function enterGarden() {
            if(!isSoundOn) toggleSound();
            startAmbientSound();
            
            const scene1 = document.getElementById('scene-1');
            const scene2 = document.getElementById('scene-2');
            
            scene1.style.transform = 'translateY(-50vh) scale(0.5)';
            scene1.style.opacity = '0';
            
            setTimeout(() => {
                scene1.style.display = 'none';
                scene2.style.display = 'block';
                
                requestAnimationFrame(() => {
                    scene2.style.opacity = '1';
                    document.getElementById('garden-text').style.animation = 'fadeIn 1.5s forwards 0.5s';
                    growMassiveGarden();
                });
            }, 800);
        }

        function growMassiveGarden() {
            const container = document.getElementById('garden-container');
            const flowerTypes = ['#svg-rose', '#svg-tulip', '#svg-daisy'];
            const numFlowers = window.innerWidth < 600 ? 120 : 250;

            for(let i = 0; i < numFlowers; i++) {
                let svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                let use = document.createElementNS("http://www.w3.org/2000/svg", "use");
                
                let type = flowerTypes[Math.floor(Math.random() * flowerTypes.length)];
                use.setAttribute("href", type);
                svg.appendChild(use);
                svg.classList.add('flower-item');
                
                let depth = Math.random(); 
                let size = depth * (window.innerWidth < 600 ? 40 : 60) + 30; 
                svg.style.width = size + 'px';
                svg.style.height = (size * 2) + 'px'; 
                svg.setAttribute("viewBox", "0 0 100 200");
                
                svg.style.left = Math.random() * 98 + 'vw';
                svg.style.zIndex = Math.floor(depth * 100);
                svg.style.bottom = `${(depth * -40) + 10}px`; 
                
                let brightness = 0.6 + (depth * 0.4);
                svg.style.filter = `brightness(${brightness})`;

                let delay = i * 0.02;
                let swaySpeed = Math.random() * 2 + 3;
                
                svg.style.animation = `bloom 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) ${delay}s forwards, sway ${swaySpeed}s ease-in-out infinite alternate ${delay+1}s`;
                
                setTimeout(() => {
                    if(isSoundOn && i % 4 === 0) playRandomChime();
                }, (delay + 0.8) * 1000);
                
                svg.onclick = openCard;
                container.appendChild(svg);
            }
        }

        let currentText = "";
        let charIndex = 0;
        let isTyping = false;

        function openCard() {
            if(isTyping) return; 
            if(isSoundOn) playRandomChime();

            const randomMsg = greetingsList[Math.floor(Math.random() * greetingsList.length)];
            
            document.getElementById('m-title').innerHTML = randomMsg.title;
            document.getElementById('m-body').innerHTML = ""; 
            document.getElementById('m-footer').style.opacity = '0';
            document.getElementById('m-sign').style.opacity = '0';
            document.getElementById('btn-group').style.opacity = '0';
            document.getElementById('btn-group').style.pointerEvents = 'none';
            document.getElementById('m-title').style.animation = 'none';

            currentText = randomMsg.body;
            charIndex = 0;

            document.getElementById('backdrop').style.display = 'block';
            document.getElementById('message-card').style.display = 'block';
            
            setTimeout(() => {
                document.getElementById('backdrop').style.opacity = '1';
                document.getElementById('message-card').style.opacity = '1';
                document.getElementById('message-card').style.transform = 'translate(-50%, -50%) scale(1)';
                
                setTimeout(() => {
                    document.getElementById('m-title').style.animation = 'fadeIn 1s forwards';
                    isTyping = true;
                    typeWriter();
                }, 600);
            }, 50);
        }

        function typeWriter() {
            if (charIndex < currentText.length) {
                let char = currentText.charAt(charIndex);
                let htmlTarget = document.getElementById("m-body");
                
                if(char === '\n') {
                    htmlTarget.innerHTML += "<br>";
                } else {
                    htmlTarget.innerHTML += char;
                }
                
                if (charIndex % 4 === 0) playTypingSound();

                charIndex++;
                setTimeout(typeWriter, Math.random() * 20 + 15); 
            } else {
                isTyping = false;
                document.getElementById('m-footer').style.animation = 'fadeIn 1s forwards';
                document.getElementById('m-sign').style.animation = 'fadeIn 1s forwards 0.5s';
                
                setTimeout(() => {
                    const btnGroup = document.getElementById('btn-group');
                    btnGroup.style.pointerEvents = 'auto';
                    btnGroup.style.opacity = '1';
                }, 1000);
            }
        }

        const btnRunaway = document.getElementById('btn-runaway');

        function moveButtonSafely(e) {
            const safeWidth = window.innerWidth - btnRunaway.offsetWidth - 20;
            const safeHeight = window.innerHeight - btnRunaway.offsetHeight - 20;

            const newX = Math.max(10, Math.floor(Math.random() * safeWidth));
            const newY = Math.max(10, Math.floor(Math.random() * safeHeight));

            btnRunaway.style.position = 'fixed';
            btnRunaway.style.left = newX + 'px';
            btnRunaway.style.top = newY + 'px';
            btnRunaway.style.bottom = 'auto'; 
            btnRunaway.style.transition = 'all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
            
            if(isSoundOn) playRandomChime();

            if(e) e.preventDefault(); 
        }

        btnRunaway.addEventListener('mouseover', moveButtonSafely);
        btnRunaway.addEventListener('touchstart', moveButtonSafely, {passive: false});

        function acceptGift() {
            alert("Đã nhận thiệp thành công! Bạn có thể nhấn vào một bông hoa khác để nhận thêm những bất ngờ khác nhé 🥰💐");
            if(isSoundOn) playRandomChime();

            document.getElementById('backdrop').style.opacity = '0';
            document.getElementById('message-card').style.opacity = '0';
            document.getElementById('btn-group').style.opacity = '0';
            
            setTimeout(() => {
                document.getElementById('backdrop').style.display = 'none';
                document.getElementById('message-card').style.display = 'none';
                btnRunaway.style.position = 'relative';
                btnRunaway.style.left = 'auto';
                btnRunaway.style.top = 'auto';
            }, 600);
        }
    </script>
</body>
</html>
